<sdf version="1.6"><world name="factory_floor">
    <plugin name="entity_state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>20</update_rate></plugin>
    <gravity>0 0 -9.81</gravity>
    <physics name="deterministic_ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate><real_time_factor>1</real_time_factor></physics>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.7 0.7 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>-0.3 -0.4 -1</direction></light>
    <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 8.2 0.1</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 8.2 0.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
    </link></model>
    <model name="wall_west"><static>true</static><pose>-6 0 0.75 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 7.9 1.5</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 7.9 1.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="wall_east"><static>true</static><pose>6 0 0.75 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 7.9 1.5</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.1 7.9 1.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="wall_north"><static>true</static><pose>0 4 0.75 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 0.1 1.5</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 0.1 1.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="wall_south"><static>true</static><pose>0 -4 0.75 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 0.1 1.5</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>12.2 0.1 1.5</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="shelf_north"><static>true</static><pose>0 1 0.6 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>1 1.5 1.2</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>1 1.5 1.2</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
    </link></model>
    <model name="shelf_south"><static>true</static><pose>0 -1 0.6 0 0 0</pose><link name="body">
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>1 1.5 1.2</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>1 1.5 1.2</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
    </link></model>
    <include><uri>model://assembly_station</uri><name>assembly_station</name><pose>-3 2 0 0 0 0</pose></include>
    <include><uri>model://inspection_station</uri><name>inspection_station</name><pose>3 2 0 0 0 0</pose></include>
    <!-- The visual payload uses explicit poses, including stable storage below the floor. -->
    <include><uri>model://factory_part</uri><name>factory_part</name><static>true</static><pose>-3 2 0.65 0 0 0</pose></include>
    <!-- Separate collision-free stripes animate above each fixed conveyor surface. -->
    <model name="assembly_conveyor"><static>true</static><pose>-3 2 0.603 0 0 0</pose><link name="belt_link">
      <visual name="stripe"><geometry><box><size>0.7 0.08 0.004</size></box></geometry><material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse></material></visual>
      <visual name="stripe_rear"><pose>0 -0.2 0 0 0 0</pose><geometry><box><size>0.7 0.08 0.004</size></box></geometry><material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse></material></visual>
    </link></model>
    <model name="inspection_conveyor"><static>true</static><pose>3 2 0.603 0 0 0</pose><link name="belt_link">
      <visual name="stripe"><geometry><box><size>0.7 0.08 0.004</size></box></geometry><material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse></material></visual>
      <visual name="stripe_rear"><pose>0 -0.2 0 0 0 0</pose><geometry><box><size>0.7 0.08 0.004</size></box></geometry><material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse></material></visual>
    </link></model>
    <model name="dynamic_obstacle"><static>false</static><pose>4 -2 0.25 0 0 0</pose><link name="obstacle_link"><inertial><mass>5</mass><inertia><ixx>0.170833</ixx><iyy>0.170833</iyy><izz>0.133333</izz></inertia></inertial>
      <collision name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
    </link></model>
</world></sdf>
