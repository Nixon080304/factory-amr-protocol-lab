#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Wait for active localization/navigation before advertising the mission command."""

import time

from lifecycle_msgs.srv import GetState
import rclpy
from rclpy.parameter import Parameter


def main():
    rclpy.init()
    node = rclpy.create_node(
        "factory_startup_probe",
        parameter_overrides=[Parameter("use_sim_time", value=True)],
    )
    deadline = time.monotonic() + 60
    clients = []
    try:
        namespaces = node.declare_parameter("robot_namespaces", [""]).value
        names = (
            "map_server",
            "amcl",
            "controller_server",
            "planner_server",
            "smoother_server",
            "behavior_server",
            "bt_navigator",
            "waypoint_follower",
            "velocity_smoother",
        )
        endpoints = [
            f"{namespace}/{name}" for namespace in namespaces for name in names
        ]
        for name in endpoints:
            client = node.create_client(GetState, f"{name}/get_state")
            clients.append(client)
            active = False
            while time.monotonic() < deadline and not active:
                if not client.wait_for_service(timeout_sec=0.1):
                    continue
                future = client.call_async(GetState.Request())
                rclpy.spin_until_future_complete(
                    node, future, timeout_sec=min(1.0, deadline - time.monotonic())
                )
                active = (
                    future.done()
                    and future.result() is not None
                    and future.result().current_state.id == 3
                )
                if not future.done():
                    future.cancel()
                if not active:
                    rclpy.spin_once(node, timeout_sec=0.1)
            if not active:
                raise SystemExit(
                    f"{name} did not activate within the 60-second startup budget"
                )
        print("AMCL and Nav2 lifecycle nodes: active", flush=True)
    except KeyboardInterrupt:
        raise SystemExit(130)
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
